# CyberChef Cloud Operations Tests
# Copy this file to `.env` and fill in your values if you want to run the Nightwatch browser tests against live Cloud APIs.
# Tests that need a credential which is not set are skipped.
CYBERCHEF_GCP_TEST_API_KEY="YOUR_API_KEY_HERE"
# Optional: if unset, tests fall back to `gcloud auth print-access-token`.
CYBERCHEF_GCP_TEST_TOKEN="YOUR_OAUTH_TOKEN_HERE"
CLIENT_ID="YOUR_CLIENT_ID_HERE"
